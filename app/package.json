  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
